{
  "uid": "readonly-rootfs-audit",
  "title": "Read-only root filesystem audit",
  "description": "Pods that the Kyverno policy require-ro-rootfs reported for a writable root filesystem. Source: Kubernetes events shipped to Loki by Alloy; the metric panel is the cross-check.",
  "tags": [
    "kyverno",
    "audit"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "namespace",
          "refId": "ns",
          "stream": "{job=\"loki.source.kubernetes_events\"}",
          "type": 1
        },
        "definition": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Findings in the last 5 minutes",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "The alert expression: ReadOnlyRootFilesystemAuditFailed fires while this is above 0.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} |= \"reason=PolicyViolation\" |= \"policy require-ro-rootfs/\" [5m])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "alertlist",
      "title": "Alert state (Loki ruler)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "The Loki alerting rule ReadOnlyRootFilesystemAuditFailed, read from the Loki ruler. It is listed while it is pending or firing and the panel is empty when there is no finding in the last 5 minutes.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 5
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 10,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "ReadOnlyRootFilesystemAuditFailed",
        "showInstances": false,
        "alertInstanceLabelFilter": "",
        "datasource": "Loki",
        "folder": null,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "normal": true,
          "error": true,
          "recovering": true
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Findings by namespace",
      "description": "Audit findings of require-ro-rootfs (Pod events with reason PolicyViolation) counted per interval.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (namespace) (count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} |= \"reason=PolicyViolation\" |= \"policy require-ro-rootfs/\" [$__interval]))",
          "legendFormat": "{{namespace}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Same finding, from the Kyverno metric",
      "description": "kyverno_validating_policy_results_total, result=fail, admission requests. The cross-check behind the alert ReadOnlyRootFilesystemAuditFailedMetric.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (resource_namespace) (increase(kyverno_validating_policy_results_total{policy_name=\"require-ro-rootfs\", result=\"fail\", execution_cause=\"admission_request\"}[$__rate_interval]))",
          "legendFormat": "{{resource_namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Pods with a finding in the time range",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (namespace, name) (count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} |= \"reason=PolicyViolation\" |= \"policy require-ro-rootfs/\" | logfmt [$__range]))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "name": "Pod",
              "Value #A": "Events"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Audit events (log lines)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "The Kubernetes events that Kyverno emits, as Alloy ships them to Loki: the Pod's PolicyViolation events for require-ro-rootfs.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} |= \"reason=PolicyViolation\" |= \"policy require-ro-rootfs/\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
